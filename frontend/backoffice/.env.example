# 복사해서 .env.local (또는 .env.development / .env.production) 로 사용한다. 실제 값은 커밋하지 않는다.

# ── 앱에서 쓰는 값 (VITE_ 접두사, 브라우저 번들에 포함됨) ──
# Google reCAPTCHA site key (공개 키)
VITE_RECAPTCHA_SITE_KEY=

# ── 로컬 개발 서버 설정 (vite.config.ts 에서만 읽음) ──
# /api 요청을 넘길 백엔드 주소
API_PROXY_TARGET=http://121.254.254.52:8200
DEV_SERVER_HOST=localadmin.altosfunding.com
DEV_SERVER_PORT=5174
# mkcert 로컬 HTTPS 사용 여부
DEV_SERVER_HTTPS=true

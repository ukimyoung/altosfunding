APP_ENV=local
# 로컬: supabase start 후 기본 주소. Render: Supabase 대시보드 > Connect > Session pooler 주소
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379/0
# 배포 환경에서는 길고 임의의 값으로 바꾼다 (예: openssl rand -hex 32)
SECRET_KEY=change-me-local-only
# 비어 있으면 local/sandbox에서는 reCAPTCHA 검증을 건너뛴다. live에서는 필수.
RECAPTCHA_SECRET_KEY=
# console: 메일을 보내지 않고 인증코드를 로그에 출력한다 (live에서는 사용 불가)
EMAIL_BACKEND=console
# refresh 쿠키. 로컬 http 개발 시에만 false
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 비밀번호 재설정 메일 링크의 사용자 Web 주소
WEB_BASE_URL=http://localhost:5173

APP_ENV=local
# 로컬: supabase start 후 기본 주소. Render: Supabase 대시보드 > Connect > Session pooler 주소
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379/0
# 배포 환경에서는 길고 임의의 값으로 바꾼다 (예: openssl rand -hex 32)
SECRET_KEY=change-me-local-only
# 비어 있으면 local/sandbox에서는 reCAPTCHA 검증을 건너뛴다. live에서는 필수.
RECAPTCHA_SECRET_KEY=
# console: 메일을 보내지 않고 인증코드를 로그에 출력한다 (live에서는 사용 불가)
EMAIL_BACKEND=console
# refresh 쿠키. 로컬 http 개발 시에만 false
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# 비밀번호 재설정 메일 링크의 사용자 Web 주소
WEB_BASE_URL=http://localhost:5173
# Google 로그인 (비어 있으면 /auth/google/* 는 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google 콘솔에 등록한 콜백 주소. 예: https://local.altosfunding.com:5173/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
# 로그인 뒤 돌아갈 수 있는 추가 사용자 웹 주소 (쉼표 구분, WEB_BASE_URL은 항상 허용)
FRONTEND_ALLOWED_ORIGINS=

# MT4 API (Tools For Brokers). 챌린지 계좌 발급은 Worker(python -m app.worker)가 이 값으로 호출한다.
# demo: 챌린지·데모 계좌 서버, live: 펀디드·라이브 계좌 서버. 요청마다 X-API-KEY 헤더로 보낸다.
MT4_DEMO_BASE_URL=
MT4_DEMO_API_KEY=
MT4_LIVE_BASE_URL=
MT4_LIVE_API_KEY=

# 제휴사(10Power·xnsoft) 회원 조회 API. 'mock'이면 개발용 가짜 회원 25명을 돌려준다 (live 불가). 비우면 가져오기 안 함.
PARTNER_MEMBERS_API_URL=
PARTNER_MEMBERS_API_KEY=
# 변경분 자동 가져오기 주기(분), 0이면 끔
PARTNER_SYNC_INTERVAL_MINUTES=30
